{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import block, lone_item, text %}
{% block body_class %}mode-debug{% endblock %}
{% block nav %} · sayfa {{ page_label }} · debug · {{ views|length }} block{% if not page.has_text_layer %} · METİN KATMANI YOK{% endif %}{% if page.continues_on_next_page %} · sonraki sayfada devam{% endif %}{% endblock %}
{% block content %}
<ul class="legend">
{% for t in ("heading", "paragraph", "list_item", "code", "image", "table", "caption", "footnote", "furniture") %}<li class="dbg t-{{ t }}">{{ t }}</li>{% endfor %}
</ul>
<main class="debug" data-page="{{ page.page_no }}">
{% for v in views %}
<section class="dbg t-{{ v.kind }}{% if v.block.aside %} is-aside{% endif %}" title="{{ v.tooltip }}">
<span class="badge">{{ v.block.order }} · {{ v.kind }}{% if v.block.heading_level is not none %} h{{ v.block.heading_level }}{% endif %}{% if v.block.aside %} · aside{% endif %}{% if v.block.list_marker is not none %} · marker “{{ v.block.list_marker }}”{% endif %}</span>
{% if v.kind == "list_item" %}{{ lone_item(v, v.en) }}{% else %}{{ block(v, v.en) }}{% endif %}
</section>
{% endfor %}
</main>
{% endblock %}
