{% extends "_base.html.j2" %}
{% from "_macros.html.j2" import attrs, block, list_item, text %}
{% block body_class %}mode-{{ mode or 'tr' }}{% endblock %}
{% block nav %} · sayfa {{ page_label }}{% if mode == 'learn' %} · öğrenme{% endif %}{% endblock %}
{% block content %}
<main class="page" data-page="{{ page.page_no }}">
{% for n in nodes %}
{% if n.kind == "list" %}
<{{ "ol" if n.ordered else "ul" }} class="list"{% if n.start is not none and n.start != 1 %} start="{{ n.start }}"{% endif %}>
{% for v in n.items %}
{{ list_item(v, v.shown, n.values[loop.index0]) }}
{% endfor %}
</{{ "ol" if n.ordered else "ul" }}>
{% elif n.kind == "figure" %}
<figure class="fig fig-{{ n.main.kind }}">
{% for c in n.before %}{{ block(c, c.shown) }}{% endfor %}
{{ block(n.main, n.main.shown) }}
{% for c in n.after %}{{ block(c, c.shown) }}{% endfor %}
</figure>
{% else %}
{{ block(n, n.shown) }}
{% endif %}
{% endfor %}
{% if footnotes %}
<aside class="footnotes">
{% for v in footnotes %}
<p {{ attrs(v) }}>{{ text(v.shown) }}</p>
{% endfor %}
</aside>
{% endif %}
</main>
{% if mode == 'learn' %}
<script>
// Word click → event for the app shell (lookup/save); the page itself never calls an AI.
document.querySelector('main.page').addEventListener('click', function (e) {
  var w = e.target.closest('.w');
  if (!w) return;
  document.querySelectorAll('.w.picked').forEach(function (x) { x.classList.remove('picked'); });
  w.classList.add('picked');
  document.dispatchEvent(new CustomEvent('rosetta:word', {
    detail: { word: w.dataset.w, lemma: w.dataset.l, block: (w.closest('[data-block]') || {}).dataset }
  }));
});
</script>
{% endif %}
{% endblock %}
