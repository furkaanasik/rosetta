{% macro text(tv) -%}
{% for s in tv.spans %}<span data-s="{{ loop.index0 }}">{{ s }}</span>{% if not loop.last %} {% endif %}{% endfor %}
{%- endmacro %}

{% macro attrs(v) -%}
data-block="{{ v.data_block }}" class="{{ v.classes }}"{% if v.style %} style="{{ v.style }}"{% endif %}
{%- endmacro %}

{% macro block(v, tv) -%}
{% if v.kind == "code" %}
<pre {{ attrs(v) }}><code>{{ v.code }}</code></pre>
{% elif v.kind in ("image", "table") %}
{% if v.img %}<img {{ attrs(v) }} src="{{ v.img }}" alt="{{ v.kind }}">{% else %}<div {{ attrs(v) }} role="img">[{{ v.kind }}]</div>{% endif %}
{% elif v.kind == "caption" %}
<figcaption {{ attrs(v) }}>{{ text(tv) }}</figcaption>
{% else %}
<{{ v.tag }} {{ attrs(v) }}>{{ text(tv) }}</{{ v.tag }}>
{% endif %}
{%- endmacro %}

{% macro list_item(v, tv, value=none) -%}
<li {{ attrs(v) }}{% if value is not none %} value="{{ value }}"{% endif %}{% if v.block.list_marker %} data-marker="{{ v.block.list_marker }}"{% endif %}>{% if v.callout %}<span class="callout" aria-hidden="true">{{ v.callout }}</span> {% endif %}{{ text(tv) }}</li>
{%- endmacro %}

{# A single list item on its own (review mode): keeps the original number. #}
{% macro lone_item(v, tv) -%}
{% if v.number is not none %}<ol class="list" start="{{ v.number }}">{{ list_item(v, tv, v.number if v.callout else none) }}</ol>{% else %}<ul class="list">{{ list_item(v, tv) }}</ul>{% endif %}
{%- endmacro %}
