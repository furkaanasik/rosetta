{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rosetta",
  "version": "0.1.0",
  "identifier": "io.github.furkanasik.rosetta",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rosetta",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost http://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*.pdf",
          "$HOME/**/*.PDF",
          "/media/**/*.pdf",
          "/media/**/*.PDF",
          "/mnt/**/*.pdf",
          "/mnt/**/*.PDF"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "Education",
    "shortDescription": "PDF çeviri okuyucu",
    "longDescription": "İngilizce PDF kitapları sayfa sayfa, onayla çeviren ve İngilizce öğrenmeye yardım eden okuyucu.",
    "externalBin": [
      "binaries/rosetta-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "education",
        "priority": "optional",
        "desktopTemplate": "linux/rosetta.desktop",
        "files": {
          "/usr/share/doc/rosetta/copyright": "../../LICENSE"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "publisher": "Furkan Asik",
    "copyright": "© 2026 Furkan Asik — AGPL-3.0-or-later",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF",
        "description": "PDF belgesi",
        "role": "Viewer"
      }
    ]
  }
}
